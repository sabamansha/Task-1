#include <iostream>
using namespace std;

int main() {
    for (int i = 0; i < 9; i++) {
        for (int j = 0; j < 20; j++) {
            if (i == 0 || i == 8 || j == 0 || j == 19)
                cout << "*";
            else if (i == 4 && j >= 8 && j <= 11)
                cout << "SABA"[j - 8];
            else
                cout << " ";
        }
        cout << endl;
    }
    return 0;
}
